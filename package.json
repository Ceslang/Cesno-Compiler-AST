{
    "name": "cesno-ast",
    "version": "0.0.0",
    "description": "A compiler that generates proofreaded Cesno AST in JSON format.",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ceslang/Cesno-Compiler-AST"
    },
    "bin": {
        "tstosc": "dist/cli/cli.js"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist/",
        "license",
        "readme.md"
    ],
    "scripts": {
        "build": "tsup --config ./tsup.config.ts",
        "test": "NODE_OPTIONS=\"$NODE_OPTIONS --input-type=module\" pnpm exec jest --config jestconfig.ts --silent=false"
    },
    "keywords": [
        "ceslang",
        "compiler",
        "ast"
    ],
    "author": "Ceslang",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.10",
        "esbuild-fix-imports-plugin": "^1.0.11",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsup": "^8.3.6",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
